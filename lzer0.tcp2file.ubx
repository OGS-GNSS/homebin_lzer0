#!/usr/bin/env bash
# Script to stream real-time u-blox GNSS receiver data into files 
# created  by DZ (Dec 2020)
# modified by DZ (Aug 2022)
# modified by sg (mar 25) - Added internal logging
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lzer0.config.sh"



#********************  DEFAULTS ********************
JOB="$(basename "$0")"
CURDIR="$(pwd)"
LOGDIR="${LZERO_LOG_DIR}"
LOGFILE="${LOGDIR}/${JOB}.log"

# Create log directory if it doesn't exist
if [[ ! -d "${LOGDIR}" ]]; then
    mkdir -p "${LOGDIR}"
fi

# Function to log messages
log() {
    echo "$(date "+%Y-%m-%d %H:%M:%S") - ${JOB} - $*" >> "${LOGFILE}"
}
log "Script started"

#********************  INPUT SETTINGS MANAGEMENT ***************
#
# If no arguments are passed it outputs script usage
if [[ $# -eq 0 ]]; then
        log "No arguments provided"
        echo "- USAGE: $JOB -f [config file]"
        echo "- USAGE: $JOB -s [site name]"
        echo "    e.g: $JOB -f $HOME/cfg/sites.cfg"
        echo "    e.g: $JOB -s L001"
        exit 1
fi

# check command line params.
while [[ $# -gt 0 ]]; do
        case "$1" in
                "-f")
                        shift
                        cfgFile="$1"
                        siteName="$(grep -v "#" "$cfgFile" | gawk 'BEGIN{FS=":"} {if ($1=="rover name") {print $2}}' | tr -d " " | tr "a-z" "A-Z")"
                        log "Using config file: $cfgFile, Site name: $siteName"
                        ;;
                "-s")
                        shift
                        siteName="$1"
                        log "Using site name: $siteName"
                        ;;
                *)
                        ;;
        esac
        shift
done

#******************** STARTS STR2STR TO RECORD REAL-TIME UBX STREAM INTO FILE
# SYNTAX
# %Y -> yyyy
# %y -> yy
# %m -> mm
# %d -> dd
# %h -> hh
# %H -> a
# %M -> mm
# %n -> ddd
# %W -> wwww
# %D -> d
# %N -> d
# %s -> ssss
# %S -> SSSS
# %r -> rrrr
log "Starting str2str process"
nohup /usr/local/bin/str2str -in tcpcli://127.0.0.1:${LZERO_RAW_TCP_PORT} -out file://${LZERO_GNSS_DIR}/%Y/%n/%H/${siteName}%H%y.%n::S=1::T -f 0 &> /dev/null &
log "str2str process started"
