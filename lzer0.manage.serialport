#!/usr/bin/env bash
# created by DZ (Aug 2022)
# gives control for the port of the GNSS to str2str (started at boot) or ser2net
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lzer0.config.sh"
#
#********************  DEFAULTS ********************
PATH="$PATH:/usr/sbin:/sbin:/usr/local/bin:/usr/bin:/bin:${LZERO_BIN_DIR}:." #fundamental to run  scripts inside cron without full path commands
JOB="$(basename "$0")"
CURDIR="$(pwd)"
KEYWORDS=(ser2net str2str)
DEVMANPERFIX=lzer0.manage
LOG_DIR="${LZERO_LOG_DIR}/"
LOG_FILE="$LOG_DIR/lzer0.manage.serialport.check.log"

# If no arguments are passed it outputs script usage
if [[ $# -eq 0 ]]; then
        echo "- USAGE: $JOB  [service/status]"
	echo "- [service] can be ${KEYWORDS[*]}"
        echo "  e.g: $JOB ${KEYWORDS[0]}"
        echo "  e.g: $JOB ${KEYWORDS[1]}"
        echo "  e.g: $JOB status"
        echo "  e.g: $JOB check"
        exit 1
fi
cmd="$1"
case "$1" in
	ser2net)
		#
		# running CHECK
		status="$("$JOB" status)"
		if [[ "$status" == "ser2net" ]]; then
			echo "$DEVMANPERFIX.${KEYWORDS[0]} is running. Nothing to do."
			echo "$DEVMANPERFIX.${KEYWORDS[1]} is stopped. Nothing to do."
		else
			echo "$DEVMANPERFIX.${KEYWORDS[1]} is stopping now."
			"$DEVMANPERFIX.${KEYWORDS[1]}" stop
			echo "$DEVMANPERFIX.${KEYWORDS[0]} is starting now."
			"$DEVMANPERFIX.${KEYWORDS[0]}" start
		fi
		;;
        str2str)
                #
                # running CHECK
		status="$("$JOB" status)"
                 if [[ "$status" == "str2str" ]]; then
                        echo "$DEVMANPERFIX.${KEYWORDS[1]} is running. Nothing to do."
                        echo "$DEVMANPERFIX.${KEYWORDS[0]} is stopped. Nothing to do."
                else
                        echo "$DEVMANPERFIX.${KEYWORDS[0]} is stopping now."
                        "$DEVMANPERFIX.${KEYWORDS[0]}" stop
                        echo "$DEVMANPERFIX.${KEYWORDS[1]} is starting now."
                        "$DEVMANPERFIX.${KEYWORDS[1]}" start
                fi
                ;;
        status)
		sta1="$("$DEVMANPERFIX.${KEYWORDS[0]}" status)"
		sta2="$("$DEVMANPERFIX.${KEYWORDS[1]}" status)"
		if [[ "$sta1" == "1" && "$sta2" == "0" ]]; then
			echo "${KEYWORDS[0]}"
		else
			if [[ "$sta1" == "0" && "$sta2" == "1" ]]; then
				echo "${KEYWORDS[1]}"
			else
				echo unkn
			fi
		fi
		;;
	check)
		sta1="$("$DEVMANPERFIX.${KEYWORDS[0]}" status)"
                sta2="$("$DEVMANPERFIX.${KEYWORDS[1]}" status)"
                if [[ "$sta1" == "1" && "$sta2" == "0" ]]; then
                        echo "[$(date "+%H:%M")] Status: ${KEYWORDS[0]}" >> "$LOG_FILE" && tail -n 1 "$LOG_FILE"
                else
                        if [[ "$sta1" == "0" && "$sta2" == "1" ]]; then
                                echo "[$(date "+%H:%M")] Status: ${KEYWORDS[1]}" >> "$LOG_FILE" && tail -n 1 "$LOG_FILE"
                        else
				echo "[$(date "+%H:%M")] Status: UNKN, launch str2str" >> "$LOG_FILE" && tail -n 1 "$LOG_FILE"
                                "$DEVMANPERFIX.${KEYWORDS[0]}" stop
                                "$DEVMANPERFIX.${KEYWORDS[1]}" start

			fi
		fi
		;;
	*)
		echo "Command not recognized. Nothing to do!"
		exit 1
		;;
esac
