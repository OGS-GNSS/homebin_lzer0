#!/usr/bin/env bash
# Script to check the lzer0.record.hourlypos status and to run it if it si stopped
# created  by DZ (Nov 2018)
# modified by DZ (Nov 2022)
# to check pos streams from str2str to file
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lzer0.config.sh"
#
# Defaults
JOB="$(basename "$0")"
LOGDIR="$LZERO_LOG_DIR"
LOGFILE="$LOGDIR/$JOB.log"

# Check if log directory exists, create it if not
if [[ ! -d "$LOGDIR" ]]; then
    mkdir -p "$LOGDIR"
fi

# Function to log messages
log() {
    echo "$(date "+%Y-%m-%d %H:%M:%S") - $JOB - $*" >> "$LOGFILE"
}

# If no arguments are passed it outputs script usage
if [[ $# -eq 0 ]]; then
        echo "- USAGE: $JOB -f [config file]"
        echo "- USAGE: $JOB -s [SITE]"
        echo "    e.g: $JOB -f $HOME/cfg/sites.cfg"
        echo "    e.g: $JOB -s L001"
        exit 1
fi
#
# check command line params.
while [[ $# -gt 0 ]]; do
        case "$1" in
                "-s")
                        # Site name
                        shift
                        SITE="$(echo "$1" | tr 'a-z' 'A-Z')"
                        ;;
                "-f")
                        #  get receiver name from config file
                        shift
                        cfgFile="$1"
                        SITE="$(grep -v "#" "$cfgFile" | gawk 'BEGIN{FS=":"} {if ($1=="rover name") {print $2}}' | tr -d " " | tr "a-z" "A-Z")"
                        ;;
                *)
                        ;;
        esac
        shift
done
RUNNINGSCRIPT=str2str
KEYWORD1=$SITE
KEYWORD2=${LZERO_POS_TCP_PORT}
RUNNINGSCRIPT_STATUS="$(ps -ef | grep "$RUNNINGSCRIPT" | grep "$KEYWORD1" | grep "$KEYWORD2" | grep -v "$JOB" | grep -v grep | wc -l)"
RUNNINGSCRIPT_PID="$(ps -ef | grep "$RUNNINGSCRIPT" | grep "$KEYWORD1" | grep "$KEYWORD2" | grep -v "$JOB" | grep -v grep | gawk '{print $2}')"
#
# CHECK.
if (( RUNNINGSCRIPT_STATUS )); then
        log "$RUNNINGSCRIPT is running with PID $RUNNINGSCRIPT_PID"
else
        log "$RUNNINGSCRIPT is stopped... Restarting now!"
        "${LZERO_BIN_DIR}/lzer0.record.hourlypos" -s "$SITE"
        log "Restarted $RUNNINGSCRIPT for site $SITE"
fi
