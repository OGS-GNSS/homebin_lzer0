#!/usr/bin/env bash
#
# Script to compress MASTER hourly GNSS data
# created  by DZ (Nov 2018)
# modified by AM (Feb 2022)
# modified by DZ (Aug 2022)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lzer0.config.sh"
#
#********************  DEFAULTS ********************
JOB="$(basename "$0")"
CURDIR="$(pwd)"
PATH="$PATH:/usr/sbin:/sbin:/usr/local/bin:/usr/bin:/bin:${LZERO_BIN_DIR}:." #fundamental to run  scripts inside cron without full path commands
#
#********************  TUNING VARIABLES BEGIN ********************
STORAGE=${LZERO_STORAGE_MOUNT}
DUMPDIR=${LZERO_GNSS_DIR}
#
# DEFAULT PARAMS
SITE=""
YEAR="$(date +%Y)"
DOY="$(date +%j)"
HOUR="$(date +%H)"
SES="$(echo "$HOUR" | hr2ses)"
FORCE="N"
PHOURS=""
#********************  TUNING VARIABLES END  ********************
#
# If no arguments are passed it outputs script usage
if [[ $# -eq 0 ]]; then
        echo "- USAGE: $JOB  -s [SITE] -y [YEAR] -d [DOY] -h [HOUR] -l [SESSION] -p [NHOURS] -w"
	echo "  -w: to overwrite old files"
	echo "  [NHOURS]: previous hours to compress"
        echo "  e.g: $JOB -s L001"
        echo "  e.g: $JOB -s L001 -y 2022"
        echo "  e.g: $JOB -s L001 -y 2022 -h 12"
        exit 1
fi
#
# check command line params.
while [[ $# -gt 0 ]]; do
        case "$1" in
                "-s")
			# Site name
			shift
			SITE="$(echo "$1" | tr 'a-z' 'A-Z')"
			;;
		"-y")
			# Year
                        shift
			YEAR="$1"
			;;
                "-d")
                        # DOY
                        shift
                        DOY="$1"
                        ;;
                "-h")
                        # Hour and session
                        shift
                        HOUR="$1"
			SES="$(echo "$HOUR" | hr2ses)"
                        ;;
                "-l")
                        # Session and hour
                        shift
                        SES="$(echo "$1" | tr 'a-z' 'A-Z')"
                        HOUR="$(echo "$SES" | hr2ses)"
                        ;;
                "-p")
                        #  Number of previous hours to compress
                        shift
			PHOURS="$1"
                        ;;
                "-w")
                        #  overwrite old file
                        FORCE="Y"
                        ;;
		*)
			shift
			;;
        esac
        shift
done
if [[ "$SITE" == "" ]]; then
	echo "- Warning, you must provide at least the site name"
	exit
else
	:
fi
site="$(echo "$SITE" | tr 'A-Z' 'a-z')"
YR="$(echo "$YEAR" | awk '{ print substr($1,3,2) }')"
if [[ "$PHOURS" == "" ]]; then
	ses="$(echo "$SES" | tr 'A-Z' 'a-z')"
        for ic in '' 'U' 'R'; do
		RAW="${DUMPDIR}/${YEAR}/${DOY}/${ses}/${ic}${SITE}${ses}$YR.$DOY"
		if [[ -e "$RAW" ]]; then
			if [[ ! -e "${RAW}.bz2" ]]; then
				echo "${RAW}.bz2 building."
				bzip2  "${RAW}"
			else
				if [[ "$FORCE" == "Y" ]]; then
					echo "${RAW}.bz2 building."
					bzip2 -f "${RAW}"
				else
					echo "${RAW}.bz2 already exists."
				fi
			fi
			break
		else
			if [[ -e "${RAW}.bz2" ]]; then
				echo "${RAW}.bz2 already exists."
				break
			fi
			echo "${RAW} not present on disk"
		fi
	done
else
	PHOURS=$((PHOURS - 1))
	for PHOUR in $(seq "$PHOURS" -1 0); do
		CurrHOUR="$(date --date="$PHOUR hour ago" +%H)"
		if [[ "$CurrHOUR" == 00 ]]; then
			modPHOUR=$((PHOUR + 1))
			CurrYEAR="$(date --date="$modPHOUR hour ago" +%Y)"
                        CurrDOY="$(date --date="$modPHOUR hour ago" +%j)"
		else
			CurrYEAR="$(date --date="$PHOUR hour ago" +%Y)"
			CurrDOY="$(date --date="$PHOUR hour ago" +%j)"
		fi
		if [[ "$FORCE" == "Y" ]]; then
			lzer0.compress.hourlygnss -s "$SITE" -y "$CurrYEAR" -d "$CurrDOY" -h "$CurrHOUR" -w
		else
			lzer0.compress.hourlygnss -s "$SITE" -y "$CurrYEAR" -d "$CurrDOY" -h "$CurrHOUR"
		fi
	done
fi
