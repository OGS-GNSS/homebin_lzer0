#!/usr/bin/env bash
# created  by DZ (Mar. 2019)
# modified by DZ (Aug. 2022)
# used to recover simple statistics from obs files generated by RTKLIB
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lzer0.config.sh"
PATH="$PATH:/usr/sbin:/sbin:/usr/local/bin:/usr/bin:/bin:${LZERO_BIN_DIR}:." #fundamental to run  scripts inside cron without full path commands
#
# MAIN JOB VALUES
StarTime="$(date +%s)"
JOB="$(basename "$0")"
TMPDIR="${LZERO_TMP_DIR}/tmp.${JOB}"
#
#********************  TUNING VARIABLES BEGIN ********************
posFile="" #default pos file
crdFile="" #default coordinates file
SITE="" #default site name
expObs=3600 # number of hourly expected observations
falseFixLim=0.05 # maximum distance deviation from reference point [m]
#********************  TUNING VARIABLES END  ********************
#
# If no arguments are passed it outputs script usage
if [[ $# -eq 0 ]]; then
        echo "- USAGE: $JOB -s [SITE] -f [pos FILE] -c [coord. FILE] -t [threshold]"
        echo "  [SITE]: [pos FILE] must include SITE coordinates in pos format"
        echo "  [pos FILE]: pos file generated by RTKLIB code."
        echo "  [coord. FILE]: a priori coordinates FILE"
        echo "  [threshold]: threshold in [m] (default 0.05) for the difference between real time values and reference values (included in the [coord. FILE])"
        echo "  e.g: $JOB -s L001 -f $HOME/Projects/RTKLIB/example1/L001.2022.08.23.235.r.pp.pos -c $HOME/tab/station.pos"
        echo "  e.g: $JOB -s L001 -f $HOME/Projects/RTKLIB/example1/L001.2022.08.23.235.r.pp.pos -c $HOME/tab/station.pos -t 0.10"
        exit 1
fi
#
# check command line params. First one is used to set the site name, second one for brand
while [[ $# -gt 0 ]]; do
        case "$1" in
                "-f")
                        #Observations File name
                        shift
                        posFile="$1"
                        ;;
		"-c")
			#a priori coordinate file name
			shift
			crdFile="$1"
			;;
                "-s")
                        #site name
                        shift
                        SITE="$1"
                        ;;
                "-t")
                        #limit in [m] for difference between real time values and reference values
			shift
                        falseFixLim="$1"
                        ;;
                *)
                        shift
                        ;;
        esac
        shift
done
if [[ "$posFile" == "" || "$SITE" == "" || "$crdFile" == "" ]]; then
        echo "- Error: one or more parameters ([SITE] and/or [pos File] and/or [coord. FILE]) are missing!"
        exit
fi

#
# Check TMPDIR
if [[ ! -e "${TMPDIR}" ]]; then
        mkdir -p "${TMPDIR}"
fi
#
# Cleaning TMPDIR
rm -fR "${TMPDIR}"/* &> /dev/null
#
# getting beginning hour from file name
hourSes="$(basename "$posFile" | gawk 'BEGIN{FS="."} {print $6}' | tr '[a-z]' '[A-Z]' | ses2hr)"
hourSes=$((hourSes - 1))
hourSes="$(echo "$hourSes" | gawk '{if (length($0) == 1) print "0"$0} {if (length($0) == 2) print $0}')"
#
# Filtering out unwanted epochs and headers
posFileTmp="$(basename "$posFile")"
posFileTmp="${TMPDIR}/${posFileTmp}"
grep -v '#' "$posFile" | gawk -v hourSes="$hourSes" '{if (substr($2,1,2) == hourSes) {print $0}}' > "$posFileTmp"
posFile="$posFileTmp"
#
#echo "Working with: $SITE"
site="$(echo "$SITE" | tr 'A-Z' 'a-z')"
SITE="$(echo "$site" | tr 'a-z' 'A-Z')"
#
# getting coords from file
read -r -a LLH_REF <<< "$(grep -v '%' "$crdFile" | gawk -v SITE="$SITE" '{if ($4==SITE) {print $1,$2,$3}}')"
read -r -a NEU_REF <<< "$(wgs842utm33 "${LLH_REF[@]}" | gawk '{print $2,$1,$3}')"
#
# gain conversion assesment
read -r -a K <<< "$(echo "${NEU_REF[*]}" "${LLH_REF[*]}" | gawk '{printf "%4.9f %4.9f",$1/$4,$2/$5}')"
obsDate="$(grep -v % "$posFile" | head -n 1 | gawk '{print $1}')"
falseFix="$(grep -v % "$posFile" | gawk \
	-v k1="${K[0]}" -v k2="${K[1]}" \
	-v neu1="${NEU_REF[0]}" -v neu2="${NEU_REF[1]}" -v neu3="${NEU_REF[2]}" \
	-v falseFixLim="$falseFixLim" \
	'{if ((sqrt(($3*k1-neu1)^2 + ($4*k2-neu2)^2 + ($5-neu3)^2)>falseFixLim) && ($6==1)) {print "FALSE FIX"}}' | wc -l)"
read -r -a obsNum <<< "$(grep -v % "$posFile" | gawk 'BEGIN{stdCnt=0;fltCnt=0;fixCnt=0} {if ($6==1) {fixCnt++}} {if ($6==2) {fltCnt++}} {if ($6==5) {stdCnt++}} END{print (NR-fixCnt-fltCnt-stdCnt),stdCnt,fltCnt,fixCnt,NR}')"
if (( obsNum[4] == 0 )); then
	exit
fi
obsVsExpPer="$(echo "${obsNum[*]}" "$expObs" | gawk '{print $5/$6*100}')" # expected Vs observed measures
falseFixPer="$(gawk -v falseFix="$falseFix" -v fix="${obsNum[3]}" 'BEGIN{print falseFix/fix*100}')" # false Fix Vs all Fix
fixPer="$(echo "${obsNum[*]}" | gawk '{print $4/$5*100}')"
fltPer="$(echo "${obsNum[*]}" | gawk '{print $3/$5*100}')"
stdPer="$(echo "${obsNum[*]}" | gawk '{print $2/$5*100}')"
othPer="$(echo "${obsNum[*]}" | gawk '{print $1/$5*100}')"
#echo "DATE obsVsExp OTH STD FLT FIX FALSE"
echo "$obsDate" "$obsVsExpPer" "$othPer" "$stdPer" "$fltPer" "$fixPer" "$falseFixPer" | gawk '{printf "%-10s %6.2f %6.2f %6.2f %6.2f %6.2f %6.2f\n",$1,$2,$3,$4,$5,$6,$7}'
#
# Removing TMPDIR
rm -fR "${TMPDIR}" &> /dev/null
