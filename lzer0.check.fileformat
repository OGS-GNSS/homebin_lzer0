#!/usr/bin/env bash
#
# Script to discover the GNSS file format (ubx, rtcm, etc).
# created  by DZ (Apr 2019)
# modified by DZ (Aug 2022)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lzer0.config.sh"
#
#********************  DEFAULTS ********************
JOB="$(basename "$0")"
CURDIR="$(pwd)"
TMPDIR="${LZERO_TMP_DIR}/tmp.${JOB}"
JOB_MON=convbin
KEYWORD=test.o
formats=(ubx rtcm3 rtcm2 nvs rinex nov oem3 ss2 hemis stq javad binex)
#********************  TUNING VARIABLES END  ********************
#
# check command line params. First one is used to set the site name, second one for brand
while [[ $# -gt 0 ]]; do
        case "$1" in
                "-f")
                        #raw File name
                        shift
                        rawFile="$1"
                        ;;
                *)
                        shift
                        ;;
        esac
        shift
done
if [[ -n "${rawFile+x}" ]]; then
	if [[ ! -e "$rawFile" ]]; then
		echo "USAGE: $JOB -f [file to check]"
		exit
	else
		mkdir -p "$TMPDIR"
		rm -fR "$TMPDIR"/* &> /dev/null
	fi
else
	echo "USAGE: $JOB -f [file to check]"
	exit
fi
for format in "${formats[@]}"; do
	("$JOB_MON" -r "$format" "$rawFile" -o "${TMPDIR}/${KEYWORD}" > /dev/null &) &> /dev/null
	sleep 8 #needed for bug files (e.g 20MB of raw data)
	PidsMonJob="$(ps -ef | grep "$KEYWORD" | gawk -v JOB_MON="${JOB_MON}" '{if ($8==JOB_MON) {print $2}}')"
	for PidMonJob in $PidsMonJob; do
		(kill_family "${PidMonJob}" > /dev/null) &> /dev/null
	done
	if [[ -e "${TMPDIR}/$KEYWORD" ]]; then
		if [[ -s "${TMPDIR}/$KEYWORD" ]]; then
   			echo "$format"
			rm -fR  "${TMPDIR}"
			exit
		fi
	fi
done
