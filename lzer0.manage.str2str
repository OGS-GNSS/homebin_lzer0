#!/usr/bin/env bash
# created by DZ (Aug 2022)
# manages main str2str stream from the serial port of the GNSS receiver to the TCP port
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lzer0.config.sh"
#
#********************  DEFAULTS ********************
PATH="$PATH:/usr/sbin:/sbin:/usr/local/bin:/usr/bin:/bin:${LZERO_BIN_DIR}:." #fundamental to run  scripts inside cron without full path commands
JOB="$(basename "$0")"
CURDIR="$(pwd)"
RUNNINGSCRIPT=str2str
KEYWORD1=serial # serial keyword used for input port
KEYWORD2=${LZERO_RAW_TCP_PORT}   # tcp keyword used for output port
RUNNINGSCRIPT_STATUS="$(ps -ef | grep "$RUNNINGSCRIPT" | grep "$KEYWORD1" | grep "$KEYWORD2" | grep -v "$JOB" | grep -v grep | wc -l)"
RUNNINGSCRIPT_PID="$(ps -ef | grep "$RUNNINGSCRIPT" | grep "$KEYWORD1" | grep "$KEYWORD2" | grep -v "$JOB" | grep -v grep | gawk '{print $2}')"
#
# If no arguments are passed it outputs script usage
if [[ $# -eq 0 ]]; then
        echo "- USAGE: $JOB  [start/stop/status/enable/disable]"
	echo "- start/stop/status to start stop and get the str2str status"
        echo "    e.g: $JOB start"
        exit 1
fi
cmd="$1"
case "$1" in
	start)
		#
		# CHECK if another str2str is running
		status="$("$JOB" status)"
		if [[ "$status" == "1" ]]; then
			echo "$RUNNINGSCRIPT is runnning with PID $RUNNINGSCRIPT_PID. Stop it before restarting!"
		else
			echo "$RUNNINGSCRIPT is not running. Restarting now!"
			"${LZERO_BIN_DIR}/lzer0.ser2tcp.ubx" &>> "${LZERO_LOG_DIR}/lzer0.ser2tcp.ubx.log"
		fi
		;;
        stop)
                #
                # CHECK if another str2str is running
		status="$("$JOB" status)"
                if [[ "$status" == "1" ]]; then
                        echo "$RUNNINGSCRIPT runnning found with PID $RUNNINGSCRIPT_PID. Stopping now!"
			kill_family "$RUNNINGSCRIPT_PID"
                else
                        echo "$RUNNINGSCRIPT is not running. Nothing to do!"
                fi
		;;
        status)
                #
                # CHECK if str2net is running
		echo "$RUNNINGSCRIPT_STATUS"
		;;
	*)
		echo "Command not recognized. Nothing to do!"
		exit 1
		;;
esac
